{
  "name": "model-evaluation-workbench",
  "private": true,
  "version": "0.2.4",
  "description": "面向提示词搭建、多模型对比、对话测试与 Excel 批量评测的本地 AI 工作站。",
  "author": "Jaimo-so",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaimo-so/model-evaluation-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/Jaimo-so/model-evaluation-workbench/issues"
  },
  "homepage": "https://github.com/Jaimo-so/model-evaluation-workbench#readme",
  "engines": {
    "node": ">=20.12"
  },
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
