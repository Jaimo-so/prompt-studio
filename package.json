    "app:mac": "zsh scripts/build-macos-app.sh",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc -b"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
